# ClickHouse Cloud
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# AkashML (OpenAI-compatible chat completions)
AKASH_API_KEY=
AKASH_BASE_URL=https://api.akashml.com/v1
AKASH_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Senso (from `senso kb create-folder` and the CURRENT.md document)
SENSO_FOLDER_ID=
SENSO_CURRENT_ID=
